# Obtén tu API key gratis en https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo de Groq a utilizar (opcional, por defecto: llama-3.3-70b-versatile)
# Otros modelos disponibles: llama-3.1-8b-instant, openai/gpt-oss-20b
GROQ_MODEL=llama-3.3-70b-versatile

# Índice del micrófono para el wake word (opcional).
# Déjalo vacío para usar el dispositivo por defecto del sistema.
# Al arrancar con LOG_LEVEL=DEBUG verás la lista "[Audio] Dispositivos de entrada"
# con el índice de cada micrófono; pon aquí el número del micrófono físico deseado.
# WAKE_WORD_DEVICE_INDEX=1
